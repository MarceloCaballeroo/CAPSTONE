NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu_anon_key
# URL pública del sitio para los enlaces de correo de Supabase Auth
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Solo servidor (nunca NEXT_PUBLIC_): permite invitar profesionales desde Configuración > Equipo
SUPABASE_SERVICE_ROLE_KEY=
# Webpay: por defecto usa el ambiente de integración con las credenciales públicas de Transbank.
# En producción: WEBPAY_AMBIENTE=produccion y las credenciales reales del comercio.
WEBPAY_AMBIENTE=integracion
WEBPAY_COMERCIO=597055555532
WEBPAY_LLAVE=579B532A7440BB0C9079DED94D31EA1615BACEB56610332264630D42D0A36B1C
# Correos de aviso (Brevo). Sin BREVO_API_KEY los correos se escriben en consola.
# EMAIL_FROM debe ser un remitente verificado en Brevo.
BREVO_API_KEY=
EMAIL_FROM=
# Protege /api/cron/avisos; Vercel lo envía como Bearer.
CRON_SECRET=
